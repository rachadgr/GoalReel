# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Environnement --------------------------------------------------------
.venv/
venv/
.env

# --- Exécutions intermédiaires --------------------------------------------
runs/
outputs/_frames/
*.log

# --- Checkpoints / poids volumineux (voir MODELS.md + scripts/download_models.sh)
# Les fichiers > 100 Mo ne peuvent pas être poussés sur GitHub sans Git LFS.
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.pth.tar
checkpoints/**/*.pkl
models/*.pt
models/*.pth
models/*.safetensors
models/*.onnx

# Modèles fournis localement (poids volumineux) — non versionnés
models/detection/*.pt
models/segmentation/*.pt
models/depth/*.pth
models/reid/*.pth
models/interpolation/*
models/super_resolution/*
models/pose/*
# Note : models/detection/** (code vendorisé RIFE, OSNet, Depth Anywhere ...)
# Le code vendorisé (vendor/rife, vendor/osnet, vendor/depth_anything_v2) EST
# versionné ; seuls les *poids* (*.pt / *.pth / *.pkl) ne le sont pas.

# Exception : le placeholder de structure models/best.pt est versionné
# (marqueur texte explicite, PAS un vrai modèle — voir MODELS.md).
!models/best.pt

# Cache modèles + logs d'inférence
.model_cache/

# On conserve la structure des dossiers vides :
!checkpoints/**/.gitkeep
!models/.gitkeep
!outputs/.gitkeep

# --- Médias volumineux ----------------------------------------------------
*.mp4
*.mov
*.mkv
*.avi
*.webm

# --- Node / web -----------------------------------------------------------
web/node_modules/
web/dist/

# --- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db
