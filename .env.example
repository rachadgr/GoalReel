# GoalReel — variables d'environnement (exemple)
# Copier vers .env et ajuster les chemins si nécessaire.

# YOLO football custom (modèle entraîné sur mesure — voir MODELS.md)
GOALREEL_YOLO_WEIGHTS=models/best.pt

# Ré-identification joueur (OSNet x1.0 Market-1501)
GOALREEL_REID_WEIGHTS=checkpoints/osnet_x1_0_market1501.pth.tar

# SAM 2.1 (Hiera Tiny)
GOALREEL_SAM2_CHECKPOINT=checkpoints/sam2.1_hiera_tiny.pt
GOALREEL_SAM2_CONFIG=

# Depth Anything V2 (ViT-S)
GOALREEL_DEPTH_CHECKPOINT=checkpoints/depth_anything_v2_vits.pth
GOALREEL_DEPTH_CONFIG=

# Back-ends optionnels
GOALREEL_OCR_BACKEND=
GOALREEL_NOVEL_VIEW_BACKEND=unavailable

# RIFE (interpolation de frames)
GOALREEL_RIFE_CHECKPOINT=checkpoints/RIFE/flownet.pkl

# Périphérique
GOALREEL_DEVICE=auto
