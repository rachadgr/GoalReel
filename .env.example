# GoalReel — variables d'environnement (exemple)
# Copier vers .env et ajuster les chemins si nécessaire.
# Convention : GOALREEL_<MODEL>_WEIGHTS / GOALREEL_<MODEL>_CONFIG etc.
# Chaque modèle peut être activé/désactivé via GOALREEL_ENABLE_<MODEL>.

# --- Répertoires ----------------------------------------------------------
GOALREEL_MODELS_DIR=models
GOALREEL_CHECKPOINTS_DIR=checkpoints
GOALREEL_VENDOR_DIR=vendor
GOALREEL_CACHE_DIR=.model_cache

# --- Périphérique ---------------------------------------------------------
GOALREEL_DEVICE=auto            # auto | cpu | cuda | cuda:0 | mps

# --- Détection (YOLO) -----------------------------------------------------
GOALREEL_DETECTOR_WEIGHTS=models/detection/yolov8s.pt
GOALREEL_DETECTOR_CONF=0.25
GOALREEL_DETECTOR_INPUT_SIZE=640
GOALREEL_DETECTOR_DEVICE=auto

# --- Segmentation (SAM 2.1) -----------------------------------------------
GOALREEL_SEGMENTER_WEIGHTS=models/segmentation/sam2.1_hiera_tiny.pt
GOALREEL_SEGMENTER_CONFIG=sam2.1_hiera_t

# --- Profondeur (Depth Anything V2) ---------------------------------------
GOALREEL_DEPTH_WEIGHTS=models/depth/depth_anything_v2_vits.pth
GOALREEL_DEPTH_INPUT_SIZE=518

# --- Ré-identification (OSNet) --------------------------------------------
GOALREEL_REID_WEIGHTS=models/reid/osnet_x1_0_imagenet.pth
GOALREEL_REID_INPUT_SIZE=256

# --- Interpolation (RIFE) -------------------------------------------------
GOALREEL_INTERPOLATION_WEIGHTS=checkpoints/RIFE/flownet.pkl

# --- Pose (optionnel) -----------------------------------------------------
# GOALREEL_POSE_WEIGHTS=models/pose/yolov8n-pose.pt

# --- Super-résolution (optionnel) -----------------------------------------
GOALREEL_ENABLE_SUPER_RESOLUTION=false
# GOALREEL_SUPER_RESOLUTION_WEIGHTS=models/super_resolution/RealESRGAN_x2.pth

# --- Caméra virtuelle / Novel view (SEVA) ---------------------------------
# Nécessite un GPU + poids HF stabilityai/stable-virtual-camera.
GOALREEL_ENABLE_VIRTUAL_CAMERA=false
GOALREEL_NOVEL_VIEW_BACKEND=unavailable   # unavailable | seva | mock
GOALREEL_SEVA_MODEL_VERSION=1.1

# --- Back-ends optionnels -------------------------------------------------
GOALREEL_OCR_BACKEND=
GOALREEL_LOG_LEVEL=INFO

# --- Performance ----------------------------------------------------------
GOALREEL_FRAME_STRIDE=15
GOALREEL_MAX_FRAMES=0            # 0 = illimité

# ==========================================================================
# GoalReel — AI Football Reel Studio (FastAPI + ComfyUI + Wan 2.2 TI2V 5B)
# ==========================================================================
# Ces variables configurent studio_server.py (goalreel/studio/*).
# Le studio fonctionne même si ComfyUI est hors ligne (/api/status indique
# alors available: false, sans crash).

# --- ComfyUI --------------------------------------------------------------
COMFY_URL=http://127.0.0.1:8188

# --- Serveur FastAPI ------------------------------------------------------
HOST=0.0.0.0
PORT=7860
MAX_UPLOAD_MB=20
CORS_ORIGINS=*                   # liste séparée par des virgules, ex: https://a.com,https://b.com

# --- Dossiers de travail (relatifs à la racine du dépôt) ------------------
# GOALREEL_STUDIO_UPLOAD_DIR=outputs/studio/uploads
# GOALREEL_STUDIO_OUTPUT_DIR=outputs/studio/reels

# --- Noms des modèles ComfyUI (déjà présents, jamais téléchargés ici) -----
# models/diffusion_models/wan2.2_ti2v_5B_fp16.safetensors
# models/vae/wan2.2_vae.safetensors
# models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors
GOALREEL_STUDIO_DIFFUSION_MODEL=wan2.2_ti2v_5B_fp16.safetensors
GOALREEL_STUDIO_VAE_MODEL=wan2.2_vae.safetensors
GOALREEL_STUDIO_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors

# --- Paramètres de génération par défaut (optimisés GPU T4) ---------------
GOALREEL_STUDIO_WIDTH=832
GOALREEL_STUDIO_HEIGHT=480
GOALREEL_STUDIO_LENGTH=49
GOALREEL_STUDIO_FPS=16
GOALREEL_STUDIO_STEPS=20
GOALREEL_STUDIO_CFG=5.0

# --- Timeouts / retries ---------------------------------------------------
GOALREEL_STUDIO_JOB_TIMEOUT=1800     # secondes d'attente max d'une génération
GOALREEL_STUDIO_POLL_INTERVAL=2.0    # intervalle de polling /history
GOALREEL_STUDIO_MAX_RETRIES=3
GOALREEL_STUDIO_RETRY_BACKOFF=1.5
GOALREEL_STUDIO_HTTP_TIMEOUT=30.0
